{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":separatePatchReleases",
    "group:recommended",
    "group:definitelyTyped",
    "group:eslintMonorepo",
    "group:typescript-eslintMonorepo",
  ],
  rebaseWhen: "conflicted",
  updateNotScheduled: false,
  commitMessagePrefix: "deps:",
  minimumReleaseAge: "3 days",
  schedule: ["every weekday"],
  prConcurrentLimit: 60,
  baseBranchPatterns: ["main"],
  platformAutomerge: false,
  ignorePaths: [
    "**/node_modules/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/tests/**",
    "**/.next/**",
    "**/.forge/**",
    "**/dist/**",
    "**/coverage/**",
  ],
  packageRules: [
    {
      description: "Automerge low-risk updates once every status check is green.",
      matchUpdateTypes: ["digest", "pin", "patch", "minor"],
      automerge: true,
    },
    {
      description: "Never automerge major updates - they need a human.",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["major"],
    },
    {
      description: "Group all patch updates.",
      matchPackageNames: ["*"],
      matchUpdateTypes: ["patch"],
      groupName: "all patch dependencies",
      groupSlug: "all-patch",
    },
    {
      description: "One PR for every GitHub Actions bump.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
    },
    {
      description: "React runtime packages ship together.",
      matchPackageNames: ["react", "react-dom", "react-test-renderer"],
      groupName: "react",
      groupSlug: "react",
    },
    {
      description: "Vite and its React plugin must match, Vitest follows them.",
      matchPackageNames: ["vite", "@vitejs/plugin-react", "vitest", "@vitest/coverage-v8", "@vitest/ui"],
      groupName: "vite + vitest",
      groupSlug: "vite-vitest",
    },
    {
      description: "Jest packages move in lockstep.",
      matchPackageNames: ["jest", "jest-environment-jsdom", "ts-jest", "jest-watch-typeahead", "jest-image-snapshot"],
      groupName: "jest",
      groupSlug: "jest",
    },
    {
      description: "Playwright browser and test packages move together.",
      matchPackageNames: ["playwright", "@playwright/test"],
      groupName: "playwright",
      groupSlug: "playwright",
    },
    {
      description: "Tailwind core and its first-party plugins share the release train.",
      matchPackageNames: [
        "tailwindcss",
        "@tailwindcss/postcss",
        "@tailwindcss/typography",
        "tailwindcss-animate",
        "tw-animate-css",
        "prettier-plugin-tailwindcss",
        "daisyui",
      ],
      groupName: "tailwind",
      groupSlug: "tailwind",
    },
    {
      description: "Postgres drivers and their test doubles.",
      matchPackageNames: ["pg", "pg-mem", "postgres", "@types/pg"],
      groupName: "postgres clients",
      groupSlug: "postgres-clients",
    },
    {
      description: "Repository tooling has no shared release train but is noise on its own.",
      matchPackageNames: ["husky", "lint-staged", "pinst", "git-cliff"],
      groupName: "repo tooling",
      groupSlug: "repo-tooling",
    },
  ],
}
